BLOCK = 4096
READ_CHUNK = 1 << 20


# ── clonefile(2) ────────────────────────────────────────────────────────────
def _load_clonefile():
    try:
        libc = ctypes.CDLL(ctypes.util.find_library("System") or "libSystem.dylib",
                           use_errno=True)
        fn = libc.clonefile
        fn.argtypes = [ctypes.c_char_p, ctypes.c_char_p, ctypes.c_uint32]
        fn.restype = ctypes.c_int
        return fn
    except (OSError, AttributeError):
        return None


_clonefile = _load_clonefile()
CLONE_NOFOLLOW = 0x0001


def clone(src, dst):
    """Clone src -> dst (dst must not exist). Raises OSError on failure."""
    rc = _clonefile(os.fsencode(src), os.fsencode(dst), CLONE_NOFOLLOW)
    if rc != 0:
        err = ctypes.get_errno()
        raise OSError(err, os.strerror(err), src, None, dst)


# ── sharing detection: F_LOG2PHYS_EXT maps logical -> PHYSICAL device offset ──
# Two files whose first extent lands on the same physical block ARE sharing it.
# This makes the filesystem its own ledger: no state file to maintain or go
# stale, and files cloned by anything else (Finder Duplicate, cp -c) count too.
# Struct MUST be packed <Iqq (20 B). The naturally-aligned 24-byte form returns
# garbage and collides across independent files -- verified.
F_LOG2PHYS_EXT = 65
_L2P = "<Iqq"


def phys_offset(path):
    """Physical device offset of the file's first extent, or None."""
    try:
        fd = os.open(path, os.O_RDONLY)
    except OSError:
        return None
    try:
        out = fcntl.fcntl(fd, F_LOG2PHYS_EXT, struct.pack(_L2P, 0, 0, 0))
        return struct.unpack(_L2P, out)[2]
    except OSError:
        return None
    finally:
        os.close(fd)


# ── helpers ─────────────────────────────────────────────────────────────────
KEYW = 16


def kv(key, value, note=""):
    """One `key : value` line — the whole output format. Machine-greppable,
    scannable by eye, no prose to skim past."""
    print(f"{key:<{KEYW}}: {value}" + (f"   # {note}" if note else ""))


def status(kind, msg):
    """Closing status line + blank line. Colour only on a TTY, so piped or
    redirected output carries the glyph and text with no ANSI escapes.
    See code-quality rule § Script Output Contract."""
    glyph, colour = {"ok": ("✓", "\033[0;32m"),
                     "warn": ("⚠", "\033[1;33m"),
                     "fail": ("✗", "\033[0;31m")}.get(kind, ("✓", "\033[0;32m"))
    stream = sys.stderr if kind == "fail" else sys.stdout
    if stream.isatty():
        print(f"{colour}{glyph} {msg}\033[0m\n", file=stream)
    else:
        print(f"{glyph} {msg}\n", file=stream)


def human(n):
    n = float(n)
    for u in ("B", "KiB", "MiB", "GiB", "TiB"):
        if abs(n) < 1024 or u == "TiB":
            return f"{n:.0f} {u}" if u == "B" else f"{n:.1f} {u}"
        n /= 1024


def df_used(path):
    """Bytes used on the volume holding `path` — the only honest measure."""
    v = os.statvfs(path)
    return (v.f_blocks - v.f_bfree) * v.f_frsize


def file_hash(path):
    h = hashlib.blake2b(digest_size=16)
    with open(path, "rb", buffering=0) as f:
        while True:
            b = f.read(READ_CHUNK)
            if not b:
                break
            h.update(b)
    return h.digest()


def collect(roots, min_size, skip_hidden):
    """-> (by_size, stats). Skips symlinks, hardlinked files, tiny files."""
    by_size = defaultdict(list)
    n_files = n_skip_link = n_skip_small = 0
    devs = set()
    for root in roots:
        for dirpath, dirnames, filenames in os.walk(root, followlinks=False):
            if skip_hidden:
                dirnames[:] = [d for d in dirnames if not d.startswith(".")]
            for name in filenames:
                p = os.path.join(dirpath, name)
                try:
                    st = os.lstat(p)
                except OSError:
                    continue
                if not statmod.S_ISREG(st.st_mode):
                    continue
                n_files += 1
                if st.st_nlink > 1:          # never disturb existing hardlinks
                    n_skip_link += 1
                    continue
                if st.st_size < min_size:    # below one block: nothing to win
                    n_skip_small += 1
                    continue
                devs.add(st.st_dev)
                by_size[st.st_size].append(p)
    return by_size, {"files": n_files, "hardlinked": n_skip_link,
                     "too_small": n_skip_small, "devices": devs}


def group_identical(by_size, verbose):
    """Size-prefilter -> cluster by physical offset -> hash one per cluster.

    Files already sharing an extent are known-identical, so a re-run costs a
    cheap fcntl instead of re-reading them. Only ONE member of each already-
    shared cluster is hashed, and clusters that turn out to match are merged.
    Returns (groups, hashed, already_shared) where a group is
    (size, [cluster, cluster, ...]) and cluster is a list of paths.
    """
    groups, hashed, already = [], 0, 0
    for size, paths in by_size.items():
        if len(paths) < 2:
            continue
        clusters = defaultdict(list)
        for p in paths:
            off = phys_offset(p)
            clusters[off if off is not None else ("solo", p)].append(p)
        already += len(paths) - len(clusters)
        if len(clusters) < 2:
            continue                      # one cluster: fully shared already
        buckets = defaultdict(list)
        for members in clusters.values():
            try:
                buckets[file_hash(members[0])].append(members)
            except OSError as e:
                if verbose:
                    print(f"  ! unreadable, skipped: {members[0]} "
                          f"({e.strerror})", file=sys.stderr)
            hashed += 1
        for cluster_list in buckets.values():
            if len(cluster_list) > 1:
                groups.append((size, cluster_list))
    return groups, hashed, already


def collapse(size, cluster_list, verbose):
    """Clone every member of clusters[1:] from clusters[0][0].

    Members already sharing the donor's extent are skipped, so this is safe
    and cheap to re-run. Returns (n_done, bytes_saved).
    """
    donor = cluster_list[0][0]
    members = [p for cl in cluster_list[1:] for p in cl]
    done = saved = 0
    for dup in members:
        d = os.path.dirname(dup)
        tmp = os.path.join(d, f".dedup-{os.getpid()}-{done}.tmp")
        try:
            st = os.lstat(dup)               # preserve THIS copy's metadata
            if os.path.exists(tmp):
                os.unlink(tmp)
            clone(donor, tmp)
            os.chmod(tmp, statmod.S_IMODE(st.st_mode))
            os.utime(tmp, (st.st_atime, st.st_mtime))
            os.replace(tmp, dup)             # atomic
            done += 1
            saved += size
            if verbose:
                print(f"  + {dup}")
        except OSError as e:
            for leftover in (tmp,):
                try:
                    os.unlink(leftover)
                except OSError:
                    pass
            print(f"  ! failed: {dup} ({e.strerror})", file=sys.stderr)
    return done, saved


def show_map(roots, pattern, min_size, skip_hidden, verbose):
    """Report which files share blocks, grouped by physical extent.

    NOTE ON "SEED": there isn't one. Once cloned, every member is an equal
    co-owner of the blocks -- deleting any of them leaves the rest wholly
    intact. The oldest member is marked only as provenance (where the content
    first appeared); nothing depends on it.
    """
    by_size, _ = collect(roots, min_size, skip_hidden)
    sets = []
    for size, paths in by_size.items():
        if len(paths) < 2:
            continue
        clusters = defaultdict(list)
        for p in paths:
            off = phys_offset(p)
            if off is not None:
                clusters[off].append(p)
        for off, members in clusters.items():
            if len(members) < 2:
                continue
            if pattern != "*" and not any(
                    fnmatch.fnmatch(os.path.basename(p), pattern) for p in members):
                continue
            sets.append((size * (len(members) - 1), size, members))

    # Single root -> show members relative to it. Long backup paths are
    # otherwise unreadable at terminal width.
    base = os.path.abspath(roots[0]) if len(roots) == 1 else None
    rel = (lambda p: os.path.relpath(p, base)) if base else (lambda p: p)
    kv("path", base or f"{len(roots)} paths")
    if pattern != "*":
        kv("filter", pattern)

    if not sets:
        kv("sets", "0")
        kv("result", "clean", "no shared sets here")
        return
    sets.sort(reverse=True)
    kv("sets", f"{len(sets):,}")
    kv("saved", human(sum(s[0] for s in sets)), "by block sharing")

    shown = sets if verbose else sets[:20]
    for n, (saved, size, members) in enumerate(shown, 1):
        members = sorted(members)
        oldest = min(members, key=lambda p: os.lstat(p).st_mtime)
        print()
        kv(f"set[{n}].name", os.path.basename(members[0]))
        kv(f"set[{n}].size", human(size))
        kv(f"set[{n}].copies", str(len(members)))
        kv(f"set[{n}].saved", human(saved))
        for m, p in enumerate(members, 1):
            kv(f"set[{n}].at[{m}]", rel(p),
               "oldest by mtime — provenance, not a dependency"
               if p == oldest else "")
    if len(sets) > len(shown):
        print()
        kv("truncated", f"{len(sets) - len(shown):,} more", "-v for all")


def show_usage(roots, min_size, skip_hidden):
    """Folder-level accounting `df` cannot do and `du` gets wrong after dedup.

      apparent  what du reports  (every file at full size)
      actual    unique extents inside this tree, each counted once

    NOT reported: "what deleting this tree would free". That differs from
    `actual` whenever an extent is ALSO referenced from outside the tree --
    those blocks survive the delete. Deciding that needs a scan of the whole
    volume, not just this subtree, so it is deliberately left out rather than
    approximated. For an isolated tree (a project under BACKUP/) the two are
    the same; for one deduped against a sibling they are not.
    """
    inside, sizes = defaultdict(list), {}
    for root in roots:
        root = os.path.abspath(root)
        apparent = 0
        for dirpath, dirnames, filenames in os.walk(root, followlinks=False):
            if skip_hidden:
                dirnames[:] = [d for d in dirnames if not d.startswith(".")]
            for name in filenames:
                p = os.path.join(dirpath, name)
                try:
                    st = os.lstat(p)
                except OSError:
                    continue
                if not statmod.S_ISREG(st.st_mode):
                    continue
                apparent += st.st_size
                if st.st_size >= min_size:
                    off = phys_offset(p)
                    if off is not None:
                        inside[off].append(p)
                        sizes[off] = st.st_size
        # An extent is "exclusive" when its link count inside this tree accounts
        # for every reference to it. st_nlink is 1 for clones, so instead we ask:
        # does the same extent appear anywhere ELSE on the volume we scanned?
        actual = sum(sizes[o] for o in inside)
        kv("path", root)
        kv("apparent", human(apparent), "what du reports")
        kv("actual", human(actual), "unique content here")
        kv("saved", human(apparent - actual), "by block sharing")
        kv("files", f"{sum(len(v) for v in inside.values()):,}")
        kv("extents", f"{len(inside):,}", "distinct")


def gather(root, min_size, skip_hidden):
    """-> (folders, sets, totals) for the HTML report.

    A "folder" is an immediate child directory of root (ver21, ver22, …).
    A file counts as SHARED when its physical extent is used by >1 file
    anywhere in the scan.
    """
    root = os.path.abspath(root)
    rows = []                                   # (folder, relpath, size, off)
    for dirpath, dirnames, filenames in os.walk(root, followlinks=False):
        if skip_hidden:
            dirnames[:] = [d for d in dirnames if not d.startswith(".")]
        for name in filenames:
            p = os.path.join(dirpath, name)
            try:
                st = os.lstat(p)
            except OSError:
                continue
            if not statmod.S_ISREG(st.st_mode):
                continue
            rp = os.path.relpath(p, root)
            top = rp.split(os.sep)[0] if os.sep in rp else "(root)"
            off = phys_offset(p) if st.st_size >= min_size else None
            rows.append((top, rp, st.st_size, off, p))

    counts = defaultdict(int)
    for _, _, _, off, _ in rows:
        if off is not None:
            counts[off] += 1

    folders = defaultdict(lambda: {"apparent": 0, "shared": 0, "files": 0})
    for top, rp, size, off, _ in rows:
        f = folders[top]
        f["apparent"] += size
        f["files"] += 1
        if off is not None and counts[off] > 1:
            f["shared"] += size

    groups = defaultdict(list)
    for top, rp, size, off, _ in rows:
        if off is not None and counts[off] > 1:
            groups[off].append((rp, size))
    sets = sorted(
        ({"name": os.path.basename(m[0][0]), "size": m[0][1], "n": len(m),
          "saved": m[0][1] * (len(m) - 1),
          "members": sorted(x[0] for x in m)}
         for m in groups.values()),
        key=lambda d: -d["saved"])

    totals = {"apparent": sum(r[2] for r in rows), "files": len(rows),
              "saved": sum(s["saved"] for s in sets)}
    return folders, sets, totals


def write_html(root, out, min_size, skip_hidden):
    folders, sets, totals = gather(root, min_size, skip_hidden)
    if not folders:
        sys.exit("dedup: nothing to report")
    order = sorted(folders.items(), key=lambda kv: -kv[1]["apparent"])
    peak = max(v["apparent"] for _, v in order) or 1

    bars = []
    for name, v in order:
        excl = v["apparent"] - v["shared"]
        bars.append(
            f'<div class="row" tabindex="0" data-f="{esc(name)}">'
            f'<div class="lbl" title="{esc(name)}">{esc(name)}</div>'
            f'<div class="track">'
            f'<div class="seg excl" style="width:{excl / peak * 100:.3f}%" '
            f'data-t="{esc(name)} — exclusive {human(excl)}"></div>'
            f'<div class="seg shar" style="width:{v["shared"] / peak * 100:.3f}%" '
            f'data-t="{esc(name)} — shared {human(v["shared"])}"></div>'
            f'</div><div class="val">{human(v["apparent"])}</div></div>')

    rowsets = []
    for s in sets[:400]:
        mem = "".join(f"<li>{esc(m)}</li>" for m in s["members"])
        rowsets.append(
            f'<details><summary><b>{esc(s["name"])}</b>'
            f'<span class="dim"> — {human(s["size"])} × {s["n"]} copies → '
            f'<b>{human(s["saved"])}</b> saved</span></summary><ul>{mem}</ul></details>')

    # Bipartite graph data: one node per SHARING SET (not per file -- 12k file
    # nodes render as noise), one per folder, an edge for each membership.
    gnodes, glinks, seen = [], [], {}
    for i, s in enumerate(sets[:600]):
        fi = len(gnodes)
        gnodes.append({"i": fi, "l": s["name"], "k": "f", "v": s["saved"],
                       "n": s["n"]})
        for m in s["members"]:
            top = m.split(os.sep)[0] if os.sep in m else "(root)"
            if top not in seen:
                seen[top] = len(gnodes)
                gnodes.append({"i": seen[top], "l": top, "k": "d", "v": 0,
                               "n": 0})
            glinks.append({"s": fi, "t": seen[top]})
    for n in gnodes:
        if n["k"] == "d":
            n["n"] = sum(1 for l in glinks if l["t"] == n["i"])

    actual = totals["apparent"] - totals["saved"]
    html = HTML_TMPL.format(
        gdata=json.dumps({"nodes": gnodes, "links": glinks}, separators=(",", ":")),
        root=esc(root), files=f'{totals["files"]:,}',
        apparent=human(totals["apparent"]), actual=human(actual),
        saved=human(totals["saved"]),
        pct=(totals["saved"] / totals["apparent"] * 100) if totals["apparent"] else 0,
        nsets=f"{len(sets):,}", ntop=min(90, len(sets)), bars="\n".join(bars),
        sets="\n".join(rowsets) or "<p class='dim'>No shared sets yet — "
                                   "run <code>dedup -a</code> first.</p>",
        more=(f'<p class="dim">Showing the 400 largest of {len(sets):,} sets.</p>'
              if len(sets) > 400 else ""))
    with open(out, "w") as f:
        f.write(html)
    return out, totals, len(sets)


def serve_it(path, idle=600):
    """Hand `path` to the shared `serve` helper and return its URL.

    `serve` is a standalone tool, not a dependency of this one: import it if
    it's on PATH, otherwise say so and fall back to the file:// path. Any
    script can adopt the same -s convention this way.
    """
    for d in os.environ.get("PATH", "").split(os.pathsep):
        cand = os.path.join(d, "serve")
        if os.path.isfile(cand) and os.access(cand, os.X_OK):
            try:
                from importlib.machinery import SourceFileLoader
                mod = SourceFileLoader("serve", cand).load_module()
                url = mod.spawn(path, idle=idle)
                subprocess.run(["open", url], check=False)
                return (f"  {url}\n  served from {os.path.dirname(path)} — "
                        f"exits after {idle}s idle (`serve stop all` to end now)")
            except Exception as e:                       # noqa: BLE001
                return f"  serve failed ({e}); open file://{os.path.abspath(path)}"
    return (f"  `serve` not found on PATH — open file://{os.path.abspath(path)}")


def esc(s):
    return (str(s).replace("&", "&amp;").replace("<", "&lt;")
            .replace(">", "&gt;").replace('"', "&quot;"))


