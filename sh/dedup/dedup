<h1>dedup map</h1><div class="sub">{root}</div>
<div class="tiles">
 <div class="tile"><div class="k">Files</div><div class="v">{files}</div></div>
 <div class="tile"><div class="k">Apparent (du)</div><div class="v">{apparent}</div></div>
 <div class="tile"><div class="k">Actual (df)</div><div class="v">{actual}</div></div>
 <div class="tile"><div class="k">Saved by sharing</div><div class="v">{saved}</div></div>
</div>
<h2>Per folder</h2>
<p class="hint">Bar length is apparent size. Orange is content shared with at
 least one other file; blue is held by this folder alone.</p>
<div class="legend"><span><i style="background:var(--excl)"></i>exclusive</span>
 <span><i style="background:var(--shar)"></i>shared</span></div>
{bars}
<h2>Graph — files ↔ folders</h2>
<p class="hint">Each orange node is one piece of content; each blue node a
 folder. An edge means that folder holds a copy. Search a filename to isolate
 it, or click any node to focus on its neighbours. Drag to reposition.</p>
<div class="legend"><span><i style="background:var(--shar)"></i>file (content)</span>
 <span><i style="background:var(--excl)"></i>folder</span>
 <span class="dim">showing the {ntop} largest sets — search to reach the rest</span></div>
<input id="gq" type="search" placeholder="isolate a file, e.g. app.js …">
<div id="gwrap"><svg id="g"></svg><div id="gtip"></div></div>
<p class="hint" id="gstat"></p>

<h2>Per file — {nsets} shared sets</h2>
<p class="hint">Every member below is an equal co-owner. Deleting any one of
 them leaves the rest completely intact; the blocks are freed only when the
 last copy goes.</p>
<input id="q" type="search" placeholder="filter by filename or path…">
<div id="sets">{sets}</div>{more}
<div class="note"><b>Why <code>du</code> and <code>df</code> disagree.</b>
 <code>du</code> adds up each file's own block count and cannot see that two
 files share extents, so it reports the apparent figure above forever.
 <code>df</code> asks the allocator and reports the actual one.</div>
</div><div id="tip"></div><script>
const tip=document.getElementById('tip');
document.querySelectorAll('.seg').forEach(s=>{{
 s.addEventListener('mousemove',e=>{{tip.textContent=s.dataset.t;tip.style.opacity=1;
  tip.style.left=Math.min(e.clientX+14,innerWidth-tip.offsetWidth-8)+'px';
  tip.style.top=(e.clientY+18)+'px';}});
 s.addEventListener('mouseleave',()=>tip.style.opacity=0);}});
document.getElementById('q').addEventListener('input',e=>{{
 const v=e.target.value.toLowerCase();
 document.querySelectorAll('#sets details').forEach(d=>{{
  d.style.display=d.textContent.toLowerCase().includes(v)?'':'none';}});}});

// ── bipartite force graph: file-content nodes <-> folder nodes ──────────────
const G={gdata}, TOP=90;
const svg=document.getElementById('g'), gtip=document.getElementById('gtip'),
      NS='http://www.w3.org/2000/svg';
let W=svg.clientWidth||900, H=520, N=[], L=[], sel=null, drag=null;

function build(filter){{
  const q=(filter||'').trim().toLowerCase();
  let files=G.nodes.filter(n=>n.k==='f');
  if(q) files=files.filter(n=>n.l.toLowerCase().includes(q));
  files=files.sort((a,b)=>b.v-a.v).slice(0,TOP);
  const keep=new Set(files.map(n=>n.i)), dirs=new Set();
  G.links.forEach(l=>{{ if(keep.has(l.s)) dirs.add(l.t); }});
  dirs.forEach(d=>keep.add(d));
  N=G.nodes.filter(n=>keep.has(n.i)).map(n=>({{...n,
      x:W/2+(Math.random()-.5)*W*.7, y:H/2+(Math.random()-.5)*H*.7, vx:0, vy:0,
      r:n.k==='d'?Math.min(16,7+Math.sqrt(n.n)):Math.min(13,4+Math.sqrt(n.n)*2)}}));
  const idx=new Map(N.map((n,j)=>[n.i,j]));
  L=G.links.filter(l=>idx.has(l.s)&&idx.has(l.t))
           .map(l=>({{s:idx.get(l.s),t:idx.get(l.t)}}));
  document.getElementById('gstat').textContent=
    `${{N.filter(n=>n.k==='f').length}} file nodes · `+
    `${{N.filter(n=>n.k==='d').length}} folders · ${{L.length}} edges`;
  for(let i=0;i<260;i++) step();
  render();
}}
function step(){{
  for(let i=0;i<N.length;i++){{const a=N[i];
    for(let j=i+1;j<N.length;j++){{const b=N[j];
      let dx=b.x-a.x, dy=b.y-a.y, d2=dx*dx+dy*dy||1;
      if(d2>90000) continue;
      const f=1400/d2, d=Math.sqrt(d2), fx=dx/d*f, fy=dy/d*f;
      a.vx-=fx; a.vy-=fy; b.vx+=fx; b.vy+=fy;}}}}
  L.forEach(l=>{{const a=N[l.s],b=N[l.t];
    const dx=b.x-a.x, dy=b.y-a.y, d=Math.hypot(dx,dy)||1, f=(d-70)*.012;
    a.vx+=dx/d*f; a.vy+=dy/d*f; b.vx-=dx/d*f; b.vy-=dy/d*f;}});
  N.forEach(n=>{{ n.vx+=(W/2-n.x)*.0016; n.vy+=(H/2-n.y)*.0016;
    n.vx*=.82; n.vy*=.82; if(n!==drag){{n.x+=n.vx; n.y+=n.vy;}}
    n.x=Math.max(n.r+22,Math.min(W-n.r-22,n.x));
    n.y=Math.max(n.r+12,Math.min(H-n.r-12,n.y)); }});
}}
function render(){{
  svg.setAttribute('viewBox',`0 0 ${{W}} ${{H}}`);
  const nb=sel==null?null:new Set(L.filter(l=>l.s===sel||l.t===sel)
                                   .flatMap(l=>[l.s,l.t]));
  let s='';
  L.forEach(l=>{{const hot=sel!=null&&(l.s===sel||l.t===sel);
    s+=`<line class="${{hot?'hot':''}}" x1="${{N[l.s].x}}" y1="${{N[l.s].y}}" `+
       `x2="${{N[l.t].x}}" y2="${{N[l.t].y}}"/>`;}});
  N.forEach((n,j)=>{{const d=nb&&!nb.has(j)?' dim':'';
    s+=`<circle class="${{n.k}}${{d}}" cx="${{n.x}}" cy="${{n.y}}" r="${{n.r}}" data-j="${{j}}"/>`;}});
  N.forEach((n,j)=>{{ if(n.k==='d'||n.r>=9||(nb&&nb.has(j))){{
    const d=nb&&!nb.has(j)?' dim':'';
    s+=`<text class="${{d}}" x="${{n.x}}" y="${{n.y-n.r-4}}">${{n.l.length>22?n.l.slice(0,21)+'…':n.l}}</text>`;}}}});
  svg.innerHTML=s;
}}
svg.addEventListener('mousemove',e=>{{
  const t=e.target; if(t.tagName!=='circle'){{gtip.style.opacity=0;
    if(drag){{const r=svg.getBoundingClientRect();
      drag.x=(e.clientX-r.left)/r.width*W; drag.y=(e.clientY-r.top)/r.height*H;
      for(let i=0;i<3;i++) step(); render();}} return;}}
  const n=N[+t.dataset.j];
  gtip.textContent=n.k==='d'?`${{n.l}} — ${{n.n}} shared files`
                            :`${{n.l}} — ${{n.n}} copies`;
  gtip.style.opacity=1;
  const r=svg.getBoundingClientRect();
  gtip.style.left=Math.min(e.clientX-r.left+12,r.width-gtip.offsetWidth-6)+'px';
  gtip.style.top=(e.clientY-r.top+14)+'px';
  if(drag){{drag.x=(e.clientX-r.left)/r.width*W; drag.y=(e.clientY-r.top)/r.height*H;
    for(let i=0;i<3;i++) step(); render();}}
}});
svg.addEventListener('mousedown',e=>{{ if(e.target.tagName==='circle'){{
  const j=+e.target.dataset.j; sel=(sel===j?null:j); drag=N[j];
  svg.classList.add('drag'); render(); }} }});
addEventListener('mouseup',()=>{{drag=null; svg.classList.remove('drag');}});
svg.addEventListener('mouseleave',()=>{{gtip.style.opacity=0;}});
document.getElementById('gq').addEventListener('input',
  e=>{{sel=null; build(e.target.value);}});
addEventListener('resize',()=>{{W=svg.clientWidth||900; render();}});
build('');
</script></body></html>"""


def main():
    ap = argparse.ArgumentParser(
        prog="dedup",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description="Make byte-identical files share disk blocks (APFS clones).",
        epilog="NOTHING IS DELETED. Every file stays readable and independent;\n"
               "writing to one never affects another (copy-on-write).\n"
               "`du` will not shrink afterwards -- only `df` shows the truth.\n\n"
               "Dry-run is the DEFAULT. Pass --apply to actually clone.")
    ap.add_argument("paths", nargs="*", help="directories to scan")
    ap.add_argument("-u", "--usage", action="store_true",
                    help="folder-level accounting: apparent (what du shows) vs "
                         "actual (unique content) vs saved — the number neither "
                         "du nor df can give you")
    ap.add_argument("-s", "--serve", action="store_true",
                    help="build the HTML report and serve it on localhost via "
                         "the shared `serve` helper (auto-opens; the server "
                         "reaps itself when idle)")
    ap.add_argument("--html", nargs="?", const="dedup-map.html", metavar="FILE",
                    help="write a self-contained HTML report (per folder + per "
                         "file) and print its path; open it directly, no server "
                         "needed (default: dedup-map.html)")
    ap.add_argument("-m", "--map", nargs="?", const="*", metavar="NAME",
                    help="report which files share blocks (no changes made). "
                         "Optional NAME is a glob on the basename, e.g. "
                         "-m 'full.jsonl' or -m '*.wasm'")
    # -a/--apply only: the bareword form (`dedup apply <dir>`) would be
    # swallowed by the `paths` positional, so the triple-flag pattern stops
    # at two here.
    ap.add_argument("-a", "--apply", action="store_true",
                    help="actually clone (default: report only)")
    ap.add_argument("-v", "--verbose", action="store_true",
                    help="list every file collapsed / skipped")
    ap.add_argument("--min-size", type=int, default=BLOCK, metavar="N",
                    help=f"ignore files smaller than N bytes (default {BLOCK})")
    # Hidden dirs are scanned BY DEFAULT: in backups/archives they hold real
    # content (.entire, .cache, .git). Skipping them measured 37x worse on a
    # real tree -- 253 MiB found vs 9.4 GiB.
    ap.add_argument("--skip-hidden", action="store_true",
                    help="do NOT descend into dot-directories (default: do)")
    args = ap.parse_args()

    if _clonefile is None:
        sys.exit("dedup: clonefile(2) unavailable — macOS/APFS required")
    # `dedup -m <dir>` reads naturally but argparse binds <dir> to -m. Recover
    # it rather than erroring on a form the help text invites.
    if args.map and args.map != "*" and not args.paths and os.path.isdir(args.map):
        args.paths, args.map = [args.map], "*"
    if not args.paths:
        args.paths = ["."]                 # no path given -> current directory
    for p in args.paths:
        if not os.path.isdir(p):
            sys.exit(f"dedup: not a directory: {p}")

    if args.usage:
        show_usage(args.paths, args.min_size, args.skip_hidden)
        return

    if args.html or args.serve:
        out = args.html or os.path.join(
            os.environ.get("TMPDIR", "/tmp"),
            f"dedup-{os.path.basename(os.path.abspath(args.paths[0]))}.html")
        out, tot, n = write_html(args.paths[0], out, args.min_size,
                                 args.skip_hidden)
        print(f"  {tot['files']:,} files · {n:,} shared sets · "
              f"{human(tot['saved'])} saved by sharing")
        if args.serve:
            print(serve_it(out))
        else:
            print(f"wrote {out}\n  open {os.path.abspath(out)}")
        return

    if args.map:
        show_map(args.paths, args.map, args.min_size, args.skip_hidden,
                 args.verbose)
        return

    by_size, s = collect(args.paths, args.min_size, args.skip_hidden)
    if len(s["devices"]) > 1:
        sys.exit("dedup: paths span multiple volumes — clonefile cannot cross "
                 "filesystems. Run once per volume.")

    groups, hashed, already = group_identical(by_size, args.verbose)
    n_of = lambda cl: sum(len(c) for c in cl)          # files across clusters
    dup_files = sum(n_of(cl) - len(cl[0]) for _, cl in groups)
    reclaimable = sum(sz * (n_of(cl) - len(cl[0])) for sz, cl in groups)

    kv("path", args.paths[0] if len(args.paths) == 1
       else f"{len(args.paths)} paths")
    kv("mode", "apply" if args.apply else "dry-run")
    kv("files_seen", f"{s['files']:,}")
    kv("hashed", f"{hashed:,}")
    if already:
        kv("already_shared", f"{already:,}")
    if s["hardlinked"]:
        kv("skipped_hardlink", f"{s['hardlinked']:,}")
    if s["too_small"]:
        kv("skipped_small", f"{s['too_small']:,}", f"< {args.min_size} B")
    kv("groups", f"{len(groups):,}")
    kv("redundant", f"{dup_files:,}")
    kv("reclaimable", human(reclaimable))

    # `result` is a single token so it can be tested: [ "$(… | awk …)" = clean ]
    if not dup_files:
        kv("result", "clean",
           "already deduped" if already else "no duplicates found")
        return

    if not args.apply:
        total = sum(sz * n_of(cl) for sz, cl in groups)
        pct = (1 - (total - reclaimable) / total) * 100 if total else 0
        kv("dup_bytes_pct", f"{pct:.1f}%")
        kv("result", "pending", "nothing changed — re-run with -a")
        return

    before = df_used(args.paths[0])
    done = saved = 0
    for size, cluster_list in groups:
        d, sv = collapse(size, cluster_list, args.verbose)
        done += d
        saved += sv
    after = df_used(args.paths[0])

    print()
    kv("collapsed", f"{done:,}")
    kv("freed", human(before - after), "df — the real number")
    kv("du_after", "unchanged", "du cannot see shared blocks")
    if done:
        status("ok", f"{done:,} files now share blocks — {human(before - after)} freed")
    else:
        status("warn", "nothing to collapse — no byte-identical duplicates found")


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit("\ndedup: interrupted (partial runs are safe — every file "
                 "replaced was byte-identical to its donor)")
