"""instls — rebuild the inventory of installed apps / Homebrew / npm / pip /
pipx items, sorted several ways, as both Markdown and a browsable HTML page.

Usage: instls [-h|--help|help] [-l|--list|list] [-o|--open|open]
              [-a|--all|all]

  (no args)   rebuild ~/bin/installeds.md and ~/bin/installeds.html
  -a          include libraries and dependencies too (see below)
  -l          show what the files hold, then offer to open them
  -o          open the HTML page in the browser straight away
  -h          this help

Sections 1-4 list only what you RUN — apps, casks, brew formulae installed on
request, npm packages shipping a command, pip packages with a console script,
and pipx tools. The libraries behind them (icu4c, libogg, brotli...) get their
own section 7, each showing how many things still need it, with genuinely
unused ones marked "UNUSED - removable" and collected in section 6 for a
single `brew autoremove`. Pass -a to mix them back into every section.

Orphan detection reads each formula's INSTALL_RECEIPT.json rather than calling
`brew autoremove --dry-run`: that command needs network and a writable cache,
and its failure is indistinguishable from a clean "nothing to remove".

Re-running always overwrites both files with a fresh snapshot; the "Last run"
timestamp at the top reflects the most recent run.

Activity dates come from Spotlight (kMDItemLastUsedDate) when it is running.
With Spotlight disabled, apps fall back to the newest mtime among their
preferences / container / Application Support / saved-state files, which
tracks real use far better than atime does.
"""
import atexit
import html
import json
import os
import plistlib
import subprocess
import sys
from concurrent.futures import ThreadPoolExecutor
from datetime import datetime, timezone

MIN_VALID = datetime(1990, 1, 1).timestamp()
OUT_MD = os.path.expanduser("~/bin/installeds.md")
OUT_HTML = os.path.expanduser("~/bin/installeds.html")
HOME = os.path.expanduser("~")
RUN_ERRORS = []
SHOW_ALL = False        # -a: include libraries/dependencies in the main lists
BREW_META = {}          # formula -> (installed_on_request, [runtime deps])

# Trailing gap — one blank line after this script's output, TTY only, so piped
# or redirected output stays exactly the data. Fires on every exit path.
atexit.register(lambda: sys.stdout.isatty() and print())


def status(kind, msg):
    """One status line: glyph + colour by outcome, colour only on a TTY."""
    glyph, colour = {"ok": ("✓", "32"), "fail": ("✗", "31"),
                     "warn": ("⚠", "33")}[kind]
    if sys.stdout.isatty():
        print(f"\033[{colour}m{glyph} {msg}\033[0m")
    else:
        print(f"{glyph} {msg}")


def run(cmd, timeout=180):
    """Run a command, returning stdout. Failures return '' but are recorded in
    RUN_ERRORS, so a missing toolchain stays distinguishable from an empty
    result — the old version swallowed both identically."""
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        if p.returncode != 0 and p.stderr.strip():
            first = p.stderr.strip().splitlines()[0]
            # Most tools already prefix their own name; don't double it up.
            RUN_ERRORS.append(first if first.startswith(cmd[0] + ":")
                              else f"{cmd[0]}: {first}")
        return p.stdout
    except FileNotFoundError:
        RUN_ERRORS.append(f"{cmd[0]}: not installed")
    except Exception as e:
        RUN_ERRORS.append(f"{cmd[0]}: {type(e).__name__}")
    return ""


def sane(ts):
    return ts if ts and ts > MIN_VALID else None


def stat_times(path):
    try:
        st = os.stat(path)
        birth = getattr(st, "st_birthtime", None) or st.st_ctime
        return sane(birth), sane(st.st_atime)
    except OSError:
        return None, None


def mtime(path):
    try:
        return sane(os.stat(path).st_mtime)
    except OSError:
        return None


def du_batch(paths, chunk=150):
    """One `du -sk` per chunk instead of one per path. Measured 3.4x faster
    over 20 apps, and this script sizes ~270 items."""
    sizes = {}
    for i in range(0, len(paths), chunk):
        out = run(["du", "-sk"] + paths[i:i + chunk], timeout=300)
        for line in out.splitlines():
            parts = line.split("\t", 1)
            if len(parts) != 2:
                continue
            try:
                sizes[parts[1]] = int(parts[0]) * 1024
            except ValueError:
                pass
    return sizes


def parse_md(v):
    if not v or v == "(null)":
        return None
    v = v.strip().strip('"')
    try:
        return datetime.strptime(v, "%Y-%m-%d %H:%M:%S %z").timestamp()
    except ValueError:
        pass
    try:
        return datetime.strptime(v[:19], "%Y-%m-%d %H:%M:%S").replace(
            tzinfo=timezone.utc).timestamp()
    except ValueError:
        return None


def spotlight_up():
    """mdls is useless when the Spotlight server is off — and it fails per-file
    rather than loudly, so check once up front instead of 270 times."""
    out = run(["mdutil", "-s", "/"], timeout=20).lower()
    return "disabled" not in out and "indexing enabled" in out


def mdls_dates(paths):
    """Map path -> (added, used), keyed by the path header mdls emits for each
    file rather than by output order. Index-based mapping silently shifted
    every later file onto the wrong dates whenever one attribute was missing."""
    out = {}
    CHUNK = 40
    for i in range(0, len(paths), CHUNK):
        chunk = paths[i:i + CHUNK]
        raw = run(["mdls", "-name", "kMDItemDateAdded",
                   "-name", "kMDItemLastUsedDate"] + chunk)
        cur, added, used = None, None, None
        for line in raw.splitlines():
            s = line.strip()
            if s.rstrip(":") in chunk:          # per-file path header
                if cur:
                    out[cur] = (parse_md(added), parse_md(used))
                cur, added, used = s.rstrip(":"), None, None
            elif s.startswith("kMDItemDateAdded"):
                added = s.split("=", 1)[1].strip()
            elif s.startswith("kMDItemLastUsedDate"):
                used = s.split("=", 1)[1].strip()
        if cur:
            out[cur] = (parse_md(added), parse_md(used))
        if len(chunk) == 1 and chunk[0] not in out:   # no header for one path
            out[chunk[0]] = (parse_md(added), parse_md(used))
    return out


# ── "do you actually run this?" ──────────────────────────────────────────────
# A cleanup inventory listing icu4c beside iMovie is worse than useless: the
# library is not separately removable (brew autoremove owns that), so every such
# row is a decision the reader cannot act on. Each test below asks the packaging
# system itself rather than guessing from the name.

def brew_receipt(receipt):
    """-> (installed_on_request, [runtime dependency names]).

    Both facts come from the formula's own INSTALL_RECEIPT.json — local, offline
    and always readable. `brew autoremove --dry-run` was the previous source and
    it needs network plus a writable cache: when either is unavailable it fails
    while the caller reported a confident "no orphaned dependencies". Reading
    the receipts computes the same answer with nothing left to fail.
    """
    try:
        with open(receipt) as f:
            d = json.load(f)
        deps = [x.get("full_name") for x in (d.get("runtime_dependencies") or [])]
        return bool(d.get("installed_on_request")), [x for x in deps if x]
    except Exception:
        # Unreadable receipt: assume requested, so it is never silently swept
        # into the removable pile on missing evidence.
        return True, []


def npm_has_bin(package_json):
    """A global npm package with no `bin` entry installs no command."""
    try:
        with open(package_json) as f:
            return bool(json.load(f).get("bin"))
    except Exception:
        return False


def pip_has_console_script(dist_info):
    """entry_points.txt declares [console_scripts]; without one the package is
    an import-only library."""
    try:
        with open(os.path.join(dist_info, "entry_points.txt")) as f:
            return "[console_scripts]" in f.read()
    except Exception:
        return False


def bundle_id(app_path):
    try:
        with open(os.path.join(app_path, "Contents", "Info.plist"), "rb") as f:
            return plistlib.load(f).get("CFBundleIdentifier")
    except Exception:
        return None


def app_activity(app_path, name):
    """Newest mtime across the files an app touches when it runs.

    atime is NOT a usable substitute on macOS: measured 27-Aug-2026, Obsidian
    had been used that same day while its bundle atime still read 29-Jul. The
    preference / container / saved-state files below tracked it correctly.
    """
    bid = bundle_id(app_path)
    cands = [os.path.join(HOME, "Library/Application Support", name)]
    if bid:
        cands += [
            os.path.join(HOME, "Library/Preferences", f"{bid}.plist"),
            os.path.join(HOME, "Library/Containers", bid,
                         "Data/Library/Preferences", f"{bid}.plist"),
            os.path.join(HOME, "Library/Saved Application State",
                         f"{bid}.savedState"),
            os.path.join(HOME, "Library/Caches", bid),
        ]
    times = [t for t in (mtime(c) for c in cands) if t]
    return max(times) if times else None


def fmt(ts):
    if ts is None:
        return "unknown"
    return datetime.fromtimestamp(ts).strftime("%Y-%m-%d %H:%M")


def fmt_size(b):
    if b is None:
        return "?"
    if b == 0:
        return "0B"
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if b < 1024:
            return f"{b:.0f}{unit}" if unit == "B" else f"{b:.1f}{unit}"
        b /= 1024
    return f"{b:.1f}PB"


def block(rows, value_fn, label_extra=None):
    width = max((len(f"{r[0]} [{r[1]}]") for r in rows), default=20)
    lines = []
    for r in rows:
        label = f"{r[0]} [{r[1]}]"
        extra = f"  {label_extra(r)}" if label_extra else ""
        lines.append(f"{label.ljust(width)}  {value_fn(r)}{extra}")
    return "\n".join(lines)


