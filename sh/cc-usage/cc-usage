def gyr_tier(pct):
    for thresh, tier in ((91, 9), (81, 8), (71, 7), (61, 6), (51, 5),
                         (41, 4), (31, 3), (21, 2), (11, 1)):
        if pct >= thresh:
            return tier
    return 0


def js_round(x):
    # Match JS Math.round (half rounds up), not Python's banker's rounding.
    return math.floor(x + 0.5)


def parse_pct(value):
    if not isinstance(value, (int, float)) or not math.isfinite(value):
        return None
    return js_round(min(100, max(0, value)))


def wrap(color, text):
    """Wrap text in an ANSI color + reset — the ubiquitous coloring idiom."""
    return "%s%s%s" % (color, text, RESET)


def colored(pct, text):
    return wrap(GYR_TEXT[gyr_tier(pct)], text)


def icon(pct, ch):
    return wrap(GYR_ICON[gyr_tier(pct)], ch)


def smoothbar(used_pct, elapsed_pct):
    """A BAR_WIDTH-cell bar: black-square fill (■) centred in the cell — the
    tallest centred fill short of a full block, keeping a gap above AND below.
    Tier-colored fill = used% (whole-cell; the exact % prints beside it), bright
    tick = elapsed% (the window's clock), thin centred rail = remaining."""
    col = GYR_ICON[gyr_tier(used_pct)]
    full = int(round(min(1.0, max(0.0, used_pct / 100.0)) * BAR_WIDTH))
    cells = []
    for i in range(BAR_WIDTH):
        if i < full:
            cells.append(wrap(col, FILL))
        else:
            cells.append(wrap(RAIL, TRACK))
    if elapsed_pct is not None:
        t = min(BAR_WIDTH - 1, max(0, int(round(elapsed_pct / 100.0 * BAR_WIDTH))))
        cells[t] = wrap(WHITE, TICK)
    return "".join(cells)


def blank_bar():
    """All-dim empty bar: no fill, no tick. Used when a window has genuinely
    no data to plot — not even elapsed/reset timing — so the display never
    fabricates a position that isn't real (same width as smoothbar for
    visual alignment with a live/cached bar)."""
    return wrap(RAIL, TRACK * BAR_WIDTH)


class HeaderDots:
    """The '...' after the timestamp, animated while the data fetch is in
    flight: each of the three dots lights in turn (rotation), signalling
    "waiting — probably refreshing". Stops the instant data is ready, freezes
    to the plain dim '...', and the render follows on the next line.

    Rewrites its single line via \\r, so it only animates on a TTY; piped or
    redirected output just gets the static line once (no escape spam)."""

    INTERVAL = 0.18

    def __init__(self, prefix):
        self.prefix = prefix            # the "  <bold stamp>" part, pre-wrapped
        self._stop = threading.Event()
        self._thread = None
        self._tty = sys.stdout.isatty()

    @staticmethod
    def _frame(i):
        lit = i % 3
        return "".join(wrap(WHITE if k == lit else DIM, ".") for k in range(3))

    def _line(self, dots):
        return "\r%s %s" % (self.prefix, dots)

    def _run(self):
        i = 0
        while not self._stop.is_set():
            try:
                sys.stdout.write(self._line(self._frame(i)))
                sys.stdout.flush()
            except (BrokenPipeError, ValueError):
                return          # reader went away (e.g. `| head`) — stop quietly
            i += 1
            self._stop.wait(self.INTERVAL)

    def start(self):
        if not self._tty:
            return
        self._thread = threading.Thread(target=self._run, daemon=True)
        self._thread.start()

    def stop(self):
        """Freeze the animation and commit the header line (static dim dots)."""
        self._stop.set()
        if self._thread is not None:
            self._thread.join(timeout=1)
        static = wrap(DIM, "...")
        # \r + rewrite so the final frame is fully overwritten on a TTY;
        # on a non-TTY this is simply the first and only write of the line.
        try:
            sys.stdout.write(self._line(static) if self._tty
                             else "%s %s" % (self.prefix, static))
            sys.stdout.write("\n")
            sys.stdout.flush()
        except (BrokenPipeError, ValueError):
            pass                # reader closed early — nothing to commit


def blank_bar_with_marker(marker_pct):
    """Like blank_bar(), but with a REAL tick placed at marker_pct — used when
    we know the weekly window's elapsed position from a persisted anchor
    (see _load_weekly_anchor) even though live/cached usage% is unavailable.
    No fill cells (we have no usage% to shade), same tick math as smoothbar."""
    cells = [wrap(RAIL, TRACK) for _ in range(BAR_WIDTH)]
    if marker_pct is not None:
        t = min(BAR_WIDTH - 1, max(0, int(round(marker_pct / 100.0 * BAR_WIDTH))))
        cells[t] = wrap(WHITE, TICK)
    return "".join(cells)


def bar_and_pct(pct, elapsed_pct, show_marker=False):
    """A window's bar followed by its right-aligned, tier-colored percent, and
    (when show_marker) the tick/marker value in dim brackets — mirrors the
    statusline's ⧗ …[L] day-step readout."""
    tail = colored(pct, ("%d%%" % pct).rjust(4))
    if show_marker and elapsed_pct is not None:
        tail += " " + wrap(DIM, "[%2d]" % elapsed_pct)
    return "%s%s" % (smoothbar(pct, elapsed_pct), tail)   # 0-space sep; rjust(4) gives the 1 lead space for 2-digit


def fmt_duration(ms):
    """Human reset time, mirroring session-line.ts formatResetTime."""
    if ms <= 0:
        return ""
    mins = math.ceil(ms / 60000)
    if mins < 60:
        return "%dm" % mins
    hours, rem = mins // 60, mins % 60
    if hours >= 24:
        days, rh = hours // 24, hours % 24
        return "%dd %dh" % (days, rh) if rh else "%dd" % days
    return "%dh %dm" % (hours, rem) if rem else "%dh" % hours


def age_str(secs):
    if secs < 5:
        return "just now"
    if secs < 60:
        return "%ds ago" % int(secs)
    if secs < 3600:
        return "%dm ago" % int(secs // 60)
    return "%dh %dm ago" % (int(secs // 3600), int((secs % 3600) // 60))


def remaining_ms(node, now_ms):
    """Ms until this window resets, or None if it carries no reset time."""
    r = node.get("resets_at")
    if isinstance(r, (int, float)) and r > 0:
        return max(0, r * 1000 - now_ms)
    return None


def elapsed_of(rem_ms, window_ms):
    """Percent of the window's clock that has elapsed (0-100)."""
    return min(100, max(0, js_round((window_ms - rem_ms) / window_ms * 100)))


def day_marker_pct(rem_ms, window_ms, now_ms=None, plan=None):
    """Day-stepped weekly marker: the cumulative % at the END of the window day
    we're currently in. Day N spans start+(N-1)d .. start+Nd, so the tick sits
    at that day's end rather than tracking the exact clock (matches how most
    people read the weekly cap). Used for the marker only; pace still uses the
    true continuous elapsed.

    Plan 0 (uniform): round(day/7*100) — day1→14, day2→29, … day7→100.
    Other plans: walk the window's CALENDAR days, adding that plan's weekday
    slot (in order, Mon-Fri) or its Sat/Sun amount, so the curve depends on
    which weekday the window starts on."""
    if rem_ms is None:
        return None
    day_ms = 24 * 60 * 60 * 1000
    elapsed_ms = max(0, window_ms - rem_ms)
    day = min(7, max(1, int(elapsed_ms // day_ms) + 1))
    if plan is None:
        plans, active = load_plans()
        plan = plans[active]
    if plan.get("uniform"):
        return int(round(day / 7.0 * 100))
    if now_ms is None:
        now_ms = time.time() * 1000
    window_start = datetime.fromtimestamp((now_ms - elapsed_ms) / 1000)
    wd = plan.get("weekday") or []
    cum, wi = 0, 0
    for i in range(day):
        # Label each 24h slot by the calendar day it MOSTLY covers (midpoint),
        # not the day it starts on. The window boundary is wherever the plan
        # happens to reset — with a late one (e.g. 21:30) the slot beginning
        # Fri 21:30 is ~21h of Saturday, so it must count as Saturday or the
        # weekend increments land a full day late.
        d = (window_start + timedelta(days=i, hours=12)).date()
        if d.weekday() == 5:                 # Saturday
            cum += plan.get("sat", 0)
        elif d.weekday() == 6:               # Sunday
            cum += plan.get("sun", 0)
        else:                                # next active-week slot
            cum += wd[wi] if wi < len(wd) else 0
            wi += 1
    return min(100, cum)


def plan_label(tier, subscription=None):
    """Human plan tag, e.g. 'Max 20×', from a rateLimitTier string like
    'default_claude_max_20x' (+ an optional subscription word for the prefix)."""
    toks = str(tier or "").split("_")
    word = str(subscription).capitalize() if subscription else None
    if not word:
        for t in toks:
            if t in ("free", "pro", "max", "team", "enterprise"):
                word = t.capitalize()
                break
    if not word:
        return None
    for t in toks:
        if len(t) >= 2 and t[-1] == "x" and t[:-1].isdigit():
            return "%s %s×" % (word, t[:-1])
    return word


def read_plan(oauth):
    """Resolve the current plan tag. Prefers ~/.claude.json's account profile
    (updated when CC re-fetches your profile, so it reflects plan upgrades) over
    the OAuth token's rateLimitTier, which is stale until the token refreshes."""
    try:
        with open(os.path.expanduser("~/.claude.json")) as f:
            oa = json.load(f).get("oauthAccount") or {}
        tier = (oa.get("userRateLimitTier") or oa.get("organizationRateLimitTier")
                or oa.get("seatTier"))
        if tier:
            label = plan_label(tier)
            if label:
                return label
    except Exception:
        pass
    if oauth:
        return plan_label(oauth.get("rateLimitTier"), oauth.get("subscriptionType"))
    return None


def weekly_pace(used_pct, elapsed_pct, remaining_ms):
    """Linear burn projection for the weekly window.
    Returns (text, tier_pct_or_None); tier None → render dim."""
    if used_pct is None or elapsed_pct is None:
        return None
    if used_pct <= 0:
        return ("0% used — full runway", 0)
    if elapsed_pct < 3:
        return ("too early to project", None)
    projected = used_pct * 100.0 / elapsed_pct
    proj_i = min(999, js_round(projected))
    if projected <= 100:
        return ("proj %d%% · %d%% spare" % (proj_i, js_round(100 - projected)), proj_i)
    # Over pace — will it hit the cap before the window resets?
    used_time_ms = max(0.0, WEEK_MS - remaining_ms)
    caps_early_ms = 0.0
    if used_time_ms > 0:
        time_to_cap_ms = (100.0 - used_pct) / used_pct * used_time_ms
        caps_early_ms = remaining_ms - time_to_cap_ms
    if caps_early_ms > 60000:
        return ("proj %d%% · caps ~%s early" % (proj_i, fmt_duration(caps_early_ms)), proj_i)
    return ("proj %d%% by reset" % proj_i, proj_i)


def read_oauth():
    """Return Claude Code's stored OAuth dict (accessToken/expiresAt/…), or None.

    Sources, in priority order — all STRICTLY READ-ONLY (cc-usage never writes,
    refreshes, or spawns anything):
      1. the CLAUDE_CODE_OAUTH_TOKEN env var — the long-lived token from
         `claude setup-token`. When set, it's the credential CC ITSELF is
         authenticating with, so cc-usage rides the exact same one. This is
         also the ONLY working source when CC can't persist to the Keychain.
      2. the macOS Keychain (CC's default store) — skipped when it holds an
         empty husk (accessToken absent), which CC leaves behind on a failed
         write.
      3. a .credentials.json file (Linux / older installs)."""
    env_tok = os.environ.get("CLAUDE_CODE_OAUTH_TOKEN", "").strip()
    if env_tok:
        return {"accessToken": env_tok}
    try:
        raw = subprocess.run(
            ["security", "find-generic-password", "-s", KEYCHAIN_SERVICE, "-w"],
            capture_output=True, text=True, timeout=5,
        ).stdout.strip()
        if raw:
            d = json.loads(raw)
            oauth = d.get("claudeAiOauth") or d
            if isinstance(oauth, dict) and oauth.get("accessToken"):
                return oauth  # ignore empty-husk entries
    except Exception:
        pass
    path = os.path.join(
        os.environ.get("CLAUDE_CONFIG_DIR", os.path.expanduser("~/.claude")),
        ".credentials.json",
    )
    try:
        with open(path) as f:
            d = json.load(f)
        return d.get("claudeAiOauth") or d
    except Exception:
        return None


def iso_to_epoch(s):
    """Parse an ISO-8601 timestamp (e.g. 2026-07-06T12:10:00.25+00:00) → epoch."""
    if not isinstance(s, str):
        return None
    try:
        return datetime.fromisoformat(s).timestamp()
    except ValueError:
        return None


def scoped_weekly(limits):
    """Per-model weekly caps from the payload's limits[] — (model, pct, active)."""
    out = []
    for lim in limits or []:
        if not isinstance(lim, dict) or lim.get("group") != "weekly":
            continue
        scope = lim.get("scope")
        model_obj = scope.get("model") if isinstance(scope, dict) else None
        model = model_obj.get("display_name") if isinstance(model_obj, dict) else None
        pct = parse_pct(lim.get("percent"))
        if model and pct is not None:
            out.append((str(model), pct, bool(lim.get("is_active"))))
    return out


def check_token_expiry():
    """Check if the stored OAuth token is expired.
    Returns (is_expired: bool, expired_ago_secs: int or None)."""
    oauth = read_oauth()
    if not oauth:
        return False, None
    exp = oauth.get("expiresAt")
    if not isinstance(exp, (int, float)) or exp <= 0:
        return False, None
    now_ms = time.time() * 1000
    if now_ms > exp:
        return True, int((now_ms - exp) / 1000)
    return False, None


# Reason the last live fetch failed (e.g. "HTTP 429"), surfaced in the cached
# fallback note so a degraded read is never mysterious. None = last fetch was OK.
_FETCH_ERR = None


def _retry_after_delay(err, default=0.6, cap=1.5):
    """Seconds to wait before a single retry, from an HTTPError's Retry-After
    header. Returns None when the server asks for longer than we're willing to
    block a usage command — then we fail fast to the cache instead."""
    try:
        ra = err.headers.get("Retry-After") if err.headers else None
    except Exception:
        ra = None
    if ra is None:
        return default
    try:
        secs = float(ra)
    except (TypeError, ValueError):
        return default  # HTTP-date form — fall back to our short default
    if secs > cap:
        return None
    return max(0.0, secs)


def fetch_live():
    """Query the live oauth/usage endpoint. Returns a normalized info dict
    (five_hour/seven_day windows, scoped model caps, plan) or None on any
    failure — the caller then falls back to the cache. Retries once on a
    transient 429/5xx; records the failure reason in _FETCH_ERR."""
    global _FETCH_ERR
    _FETCH_ERR = None
    if os.environ.get("CC_USAGE_OFFLINE"):
        _FETCH_ERR = "offline"
        return None
    oauth = read_oauth()
    if not oauth:
        _FETCH_ERR = "credentials unreadable"
        return None
    tok = oauth.get("accessToken")
    if not tok:
        # Newer Claude Code transiently stores an EMPTY accessToken while
        # rotating — name the state so the fallback note isn't mysterious.
        _FETCH_ERR = "no token"
        return None
    exp = oauth.get("expiresAt")
    # exp > 0 guard: newer Claude Code writes expiresAt: 0 ("no expiry
    # recorded") — try the fetch anyway; a genuinely dead token surfaces as
    # HTTP 401 in _FETCH_ERR rather than a silent skip. Matches
    # check_token_expiry(), which also treats exp <= 0 as not-expired.
    if isinstance(exp, (int, float)) and exp > 0 and time.time() * 1000 > exp:
        _FETCH_ERR = "token expired"
        return None  # _fetch_info() kicks a background refresh; cached for now
    req = urllib.request.Request(
        USAGE_URL,
        headers={
            "Authorization": "Bearer %s" % tok,
            "anthropic-beta": OAUTH_BETA,
            "Content-Type": "application/json",
            "User-Agent": USER_AGENT,
        },
    )
    payload = None
    for attempt in range(2):
        try:
            with urllib.request.urlopen(req, timeout=NET_TIMEOUT) as r:
                payload = json.load(r)
            break
        except urllib.error.HTTPError as e:
            _FETCH_ERR = "HTTP %s" % e.code
            delay = _retry_after_delay(e) if e.code in (429, 500, 502, 503) else None
            if attempt == 0 and delay is not None:
                time.sleep(delay)
                continue
            return None
        except Exception as e:
            _FETCH_ERR = type(e).__name__
            return None
    if not isinstance(payload, dict):
        _FETCH_ERR = _FETCH_ERR or "bad response"
        return None
    _FETCH_ERR = None

    def window(node):
        node = node or {}
        return {
            "used_percentage": node.get("utilization"),
            "resets_at": iso_to_epoch(node.get("resets_at")),
        }

    info = {
        "five_hour": window(payload.get("five_hour")),
        "seven_day": window(payload.get("seven_day")),
        "scoped": scoped_weekly(payload.get("limits")),
        "plan": read_plan(oauth),
        "source": "live",
        "age": 0.0,
    }
    # A 200 whose windows are all empty (seen during token/plan transitions)
    # is a MISS, not "this account has no limits" — record why and fall back
    # to cache so the footer explains instead of misleading.
    if (info["five_hour"]["used_percentage"] is None
            and info["seven_day"]["used_percentage"] is None
            and not info["scoped"]):
        _FETCH_ERR = "empty usage payload"
        return None
    return info


# NOTE: cc-usage shows whatever the cache holds, as fresh as it is — the
# "cached · <age> ago" footer discloses staleness rather than hiding fields.
# The only content it suppresses is a window whose reset has already PASSED
# (see _drop_expired_windows) — that's genuine fiction, not mere staleness.


def _drop_expired_windows(info, now_ms=None):
    """Blank any CACHED window whose resets_at has already passed.

    Such a reading describes a cycle that has ENDED, so its used_percentage
    is fiction for the current one — and with remaining=0 the elapsed marker
    would pin to [100] with an empty countdown, which reads like a full
    window rather than a dead one. A window still running keeps its value
    even when the reading is old: the number refers to the live cycle, just
    measured earlier (that is staleness, not fiction). Scoped caps ride the
    weekly window, so they clear with it."""
    if not info:
        return info
    if now_ms is None:
        now_ms = time.time() * 1000
    for key in ("five_hour", "seven_day"):
        r = (info.get(key) or {}).get("resets_at")
        if isinstance(r, (int, float)) and r > 0 and r * 1000 <= now_ms:
            info[key] = {}
            if key == "seven_day":
                info["scoped"] = []
    return info


def load_cc_cache():
    """Claude Code's own usage-API cache (~/.claude/.usage_cache.json).

    Preferred fallback: it is the SAME payload shape the live endpoint
    returns, so it yields the full picture — both windows AND the per-model
    scoped caps — where the statusline mirror only carries the two headline
    windows. Returns an info dict, or None if absent/unusable."""
    try:
        with open(CC_CACHE) as f:
            payload = json.load(f)
        age = time.time() - os.path.getmtime(CC_CACHE)
    except (OSError, ValueError):
        return None
    if not isinstance(payload, dict):
        return None

    def window(node):
        node = node or {}
        return {
            "used_percentage": node.get("utilization"),
            "resets_at": iso_to_epoch(node.get("resets_at")),
        }

    info = {
        "five_hour": window(payload.get("five_hour")),
        "seven_day": window(payload.get("seven_day")),
        "scoped": scoped_weekly(payload.get("limits")),
        "plan": None,
        "source": "cc-cache",
        "age": age,
    }
    info = _drop_expired_windows(info)
    # All-empty means the file exists but says nothing usable (or everything
    # in it has expired) — treat as a miss so the next fallback gets its turn.
    if (not info["five_hour"].get("used_percentage")
            and not info["seven_day"].get("used_percentage")
            and not info["scoped"]):
        return None
    return info


def load_cache():
    """Fallback source (degraded: headline windows only). Returns an info dict
    or None."""
    # Newest of the known mirror locations (current first, retired one as
    # fallback) — whichever was written most recently wins.
    paths = [p for p in CACHE_PATHS if os.path.exists(p)]
    if not paths:
        return None
    path = max(paths, key=os.path.getmtime)
    try:
        with open(path) as f:
            data = json.load(f)
        age = time.time() - os.path.getmtime(path)
    except (ValueError, OSError):
        return None
    rl = (data or {}).get("rate_limits") or {}

    def window(node):
        # The statusline payload carries resets_at as an ISO STRING, while
        # remaining_ms/elapsed_of expect epoch seconds — convert here or the
        # countdown and tick silently vanish from this path.
        node = node or {}
        r = node.get("resets_at")
        if isinstance(r, str):
            r = iso_to_epoch(r)
        return {"used_percentage": node.get("used_percentage"), "resets_at": r}

    info = {
        "five_hour": window(rl.get("five_hour")),
        "seven_day": window(rl.get("seven_day")),
        "scoped": [],
        "plan": None,
        "source": "cached",
        "age": age,
    }
    return _drop_expired_windows(info)


