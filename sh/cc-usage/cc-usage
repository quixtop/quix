def _plan_desc(p):
    """One-line description of a plan's increments."""
    if p.get("uniform"):
        return "every day ≈ 100/7 (calendar-agnostic)"
    return "wd %s · sat +%d sun +%d" % (
        " ".join(str(x) for x in p.get("weekday", [])),
        p.get("sat", 0), p.get("sun", 0))


def _plan_list_detail(p):
    """Second line of a -l entry. Separate from _plan_desc because that one is
    a one-liner shared by the status and apply paths; here the ramp needs the
    same two-space column rhythm as the curve printed directly beneath it, so
    the two read as one aligned block."""
    if p.get("uniform"):
        return "every day ≈ 100/7 (calendar-agnostic)"
    ramp = "".join("  %d" % x for x in p.get("weekday", []))
    return "week :%s · sat +%d sun +%d" % (ramp, p.get("sat", 0), p.get("sun", 0))


def emit_plan_list():
    """-l/--list: every plan, the active one marked, plus each one's cumulative
    curve for the CURRENT window (so the effect is visible, not abstract)."""
    plans, active = load_plans()
    now_ms = time.time() * 1000
    anchor = _load_weekly_anchor(now_ms)
    rem = remaining_ms({"resets_at": anchor}, now_ms) if anchor else None
    print()
    print("  " + wrap(BOLD, "cc-usage — timeline plans"))
    print()
    for pid in sorted(plans):
        p = plans[pid]
        mark = wrap(WHITE, "▸") if pid == active else " "
        print("  %s %d  %s" % (mark, pid, p.get("name", "plan %d" % pid)))
        print("       " + wrap(DIM, _plan_list_detail(p)))
        if rem is not None:
            day_ms = 24 * 60 * 60 * 1000
            elapsed = max(0, WEEK_MS - rem)
            curve = []
            for n in range(7):               # cumulative at each day's end
                probe = WEEK_MS - (n * day_ms)
                curve.append(day_marker_pct(probe, WEEK_MS, now_ms - elapsed + n * day_ms, p))
            print("       " + wrap(DIM, "curve:" + "".join("  %d" % c for c in curve)))
    print()
    print("  " + wrap(DIM, "apply : cc-usage plan <n>"))
    print("  " + wrap(DIM, "define: cc-usage set sat=10 sun=5 wd=21,19,17,15,13"))
    print()
    return 0


def set_active_plan(args):
    """-p/--plan <n>: persist <n> as the active plan."""
    if not args:
        sys.stderr.write("cc-usage: -p needs a plan number (see cc-usage -l)\n")
        return 1
    try:
        pid = int(args[0])
    except ValueError:
        sys.stderr.write("cc-usage: plan must be a number (see cc-usage -l)\n")
        return 1
    plans, _ = load_plans()
    if pid not in plans:
        sys.stderr.write("cc-usage: no plan %d (see cc-usage -l)\n" % pid)
        return 1
    cfg = _read_plan_cfg()
    cfg["active"] = pid
    if not _write_plan_cfg(cfg):
        sys.stderr.write("cc-usage: could not write %s\n" % PLANS_FILE)
        return 1
    p = plans[pid]
    print("  plan %d (%s) active — %s" % (pid, p.get("name", ""), _plan_desc(p)))
    return 0


def define_plan(args):
    """-s/--set sat=<n> sun=<n> wd=<n,n,n,n,n> [name=<label>]: define a new
    plan, validate it totals 100, save it under the next free id and activate
    it. Lets future plans differ from the built-ins without touching code."""
    spec = {}
    for a in args:
        if "=" in a:
            k, v = a.split("=", 1)
            spec[k.strip().lower()] = v.strip()
    try:
        sat, sun = int(spec["sat"]), int(spec["sun"])
        wd = [int(x) for x in spec["wd"].split(",") if x.strip()]
    except (KeyError, ValueError):
        sys.stderr.write(
            "cc-usage: need sat=<n> sun=<n> wd=<n,n,n,n,n>\n"
            "      e.g. cc-usage -s sat=10 sun=5 wd=21,19,17,15,13\n")
        return 1
    if len(wd) != 5:
        sys.stderr.write("cc-usage: wd needs exactly 5 values (the Mon-Fri slots)\n")
        return 1
    total = sum(wd) + sat + sun
    if total != 100:
        sys.stderr.write("cc-usage: increments total %d — must be exactly 100\n" % total)
        return 1
    cfg = _read_plan_cfg()
    plans, _ = load_plans()
    pid = max(plans) + 1
    plan = {"name": spec.get("name", "custom %d" % pid),
            "weekday": wd, "sat": sat, "sun": sun}
    cfg["custom"][str(pid)] = plan
    cfg["active"] = pid
    if not _write_plan_cfg(cfg):
        sys.stderr.write("cc-usage: could not write %s\n" % PLANS_FILE)
        return 1
    print("  plan %d (%s) created and active — %s"
          % (pid, plan["name"], _plan_desc(plan)))
    return 0


def main():
    arg = sys.argv[1] if len(sys.argv) > 1 else ""
    rest = sys.argv[2:]

    # Triple-form dispatch (short | long | bare word) per the shrix CLI
    # convention. Safe here because cc-usage takes no free-form positionals —
    # the first arg is always a mode selector, so a bare word can never
    # collide with a real value.
    if arg in ("-h", "--help", "help"):
        print(HELP)
        return 0

    if arg in ("-l", "--list", "list"):
        return emit_plan_list()

    if arg in ("-p", "--plan", "plan"):
        return set_active_plan(rest)

    if arg in ("-s", "--set", "set"):
        return define_plan(rest)

    if arg == "--json":
        return emit_json()

    if arg == "--html":
        return emit_html()

    if arg == "--widget":
        return emit_widget()

    # Header first, with its dots animating while the fetch/refresh runs — the
    # wait is the signal ("not instantaneous" = it's refreshing). Both render
    # paths below therefore start AFTER the header is already committed.
    now = datetime.now()
    stamp = "%s / %s" % (
        now.strftime("%d%b%y"),
        now.strftime("%I.%M%p").lower().replace("m", ""),
    )
    print()
    dots = HeaderDots("  " + wrap(BOLD, stamp))
    dots.start()
    try:
        info = _fetch_info()
    finally:
        dots.stop()          # freeze + commit the header line, whatever happened

    if info is None:
        sys.stderr.write(
            "cc-usage: live usage unavailable and no cache to fall back on.\n"
            "      Sign in to Claude Code, or run any CLI session once so its\n"
            "      statusline renders (%s).\n" % CACHE
        )
        return 1

    five = info["five_hour"]
    seven = info["seven_day"]
    five_pct = parse_pct(five.get("used_percentage"))
    seven_pct = parse_pct(seven.get("used_percentage"))

    if five_pct is None and seven_pct is None:
        # No data to plot at all (not even window/reset timing) — render a
        # blank skeleton instead of an error dump: same shape as the live
        # view, dashes only, no fabricated fill/tick/number.
        is_expired, expired_ago = check_token_expiry()
        if is_expired and expired_ago is not None:
            reason = "token expired %s — auto-refreshing, glance again" % age_str(expired_ago)
        elif _FETCH_ERR:
            reason = "live fetch failed: %s" % _FETCH_ERR
        else:
            reason = "no rate limits reported (no active plan limits?)"
        now_ms = time.time() * 1000
        print()
        # Weekly only. The session row is omitted with no data: the 5h window
        # isn't anchored, so it would be a bare rail carrying nothing at all —
        # weekly at least still shows its day-marker and countdown.
        tail = blank_bar() + " " + wrap(DIM, "NA")
        anchor = _load_weekly_anchor(now_ms)
        if anchor is not None:
            rem = remaining_ms({"resets_at": anchor}, now_ms)
            marker = day_marker_pct(rem, WEEK_MS)
            tail = (blank_bar_with_marker(marker) + " " + wrap(DIM, "NA")
                    + " " + wrap(DIM, "[%2d]" % marker) + " | " + fmt_duration(rem))
        print("  %s %-7s %s" % (wrap(RAIL, "⧗"), "weekly", tail))
        print("\n  " + wrap(DIM, reason))
        print()
        return 0

    now_ms = time.time() * 1000
    lines = []              # (icon_str, label, tail)
    weekly_elapsed = None   # continuous — for PACE
    weekly_marker = None    # day-stepped — for the TICK (shared w/ per-model caps)

    # ── 5-hour window (◐) ────────────────────────────────────────────────
    if five_pct is not None:
        rem = remaining_ms(five, now_ms)
        elapsed = elapsed_of(rem, SESSION_MS) if rem is not None else None
        tail = bar_and_pct(five_pct, elapsed, show_marker=True)
        if rem is not None:
            tail += " | %s" % fmt_duration(rem)
        lines.append((icon(five_pct, "◐"), "session", tail))

    # ── Weekly window (⧗) + pace ─────────────────────────────────────────
    if seven_pct is not None:
        rem = remaining_ms(seven, now_ms)
        weekly_elapsed = elapsed_of(rem, WEEK_MS) if rem is not None else None
        weekly_marker = day_marker_pct(rem, WEEK_MS) if rem is not None else None
        tail = bar_and_pct(seven_pct, weekly_marker, show_marker=True)
        if rem is not None:
            tail += " | %s" % fmt_duration(rem)
        lines.append((icon(seven_pct, "⧗"), "weekly", tail))
        if weekly_elapsed is not None:
            pace = weekly_pace(seven_pct, weekly_elapsed, rem)
            if pace and SHOW_PACE:
                text, tier = pace
                lines.append((" ", "pace",
                              colored(tier, text) if tier is not None else wrap(DIM, text)))

    # ── Per-model weekly caps (✦) — hidden once a model drops to 0% ──────
    for model, pct, active in info["scoped"]:
        if not pct:
            continue
        tail = bar_and_pct(pct, weekly_marker, show_marker=True)
        if active:
            tail += " " + wrap(DIM, "binding")
        lines.append((icon(pct, "✦"), model.lower(), tail))

    lbl_w = max(len(label) for _, label, _ in lines)
    print()
    for icon_str, label, tail in lines:
        print("  %s %-*s %s" % (icon_str, lbl_w, label, tail))
    # Footer only when the data isn't live-fresh — a staleness flag, not noise.
    if info["source"] != "live":
        footer = "as of %s · %s" % (age_str(info["age"]), info["source"])
        is_expired, expired_ago = check_token_expiry()
        if is_expired and expired_ago is not None:
            footer += " · token expired %s — auto-refreshing, glance again" % age_str(expired_ago)
        elif _FETCH_ERR == "HTTP 403":
            # Permanent, not a glitch: the env token authenticates CC but lacks
            # the scope for the usage endpoint, so a direct live fetch is always
            # forbidden — cc-usage rides the cache. Phrase it calmly, not "failed".
            footer += " · live n/a (token lacks usage scope)"
        elif _FETCH_ERR:
            footer += " · live fetch failed: %s" % _FETCH_ERR
        elif info["age"] > STALE_AFTER:
            footer += " · live unavailable"
        print("\n  " + wrap(DIM, footer))
    print()
    return 0


if __name__ == "__main__":
    sys.exit(main())
