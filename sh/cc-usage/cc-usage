env:
  CC_USAGE_OFFLINE        set to skip the live call and use the cache only
  CC_USAGE_TIMEOUT        live request timeout in seconds (default 4)
  CLAUDE_CONFIG_DIR      Claude config dir (default ~/.claude); the fallback
                         cache is <dir>/plugins/claude-hud/.last-stdin.json
  CC_USAGE_STALE_AFTER    seconds before a cached fallback is flagged stale (300)
"""


def _save_weekly_anchor(resets_at):
    """Persist the weekly window's resets_at (epoch seconds) to ANCHOR_FILE
    whenever fetch_live() sees a real one. Best-effort — a write failure here
    must never break a usage render."""
    if not (isinstance(resets_at, (int, float)) and resets_at > 0):
        return
    try:
        with open(ANCHOR_FILE, "w") as f:
            json.dump({"resets_at": resets_at}, f)
    except OSError:
        pass


def _load_weekly_anchor(now_ms):
    """Last-known weekly resets_at, PROJECTED FORWARD if that window has since
    rolled over. The weekly cap is a strict 7-day cycle, so a past reset still
    pins the cycle's phase — adding whole weeks until it lands in the future
    yields the current window's real boundary (a projection from observed
    data, not a fabricated position). Returns epoch seconds or None."""
    try:
        with open(ANCHOR_FILE) as f:
            resets_at = json.load(f).get("resets_at")
    except (OSError, ValueError):
        return None
    if not (isinstance(resets_at, (int, float)) and resets_at > 0):
        return None
    week_s = WEEK_MS / 1000.0
    now_s = now_ms / 1000.0
    if resets_at <= now_s:
        periods = math.floor((now_s - resets_at) / week_s) + 1
        resets_at += periods * week_s   # advance to the current cycle
    return resets_at


def _fetch_info():
    """Live usage if the endpoint answers, else cached — STRICTLY READ-ONLY.
    Order: live endpoint → Claude Code's own usage-API cache (full payload incl.
    scoped caps) → the statusline mirror. Persists the weekly deadline it last
    saw (see _save_weekly_anchor) for the no-data day-marker.

    cc-usage NEVER spawns a process and NEVER touches credentials — it only
    reads what Claude Code already stores. (The former background token-refresh,
    which spawned `claude mcp list` to rotate the OAuth token, was REMOVED: it
    was the only auth-touching part of cc-usage and a possible aggravator of
    login/Keychain churn. Refreshing the token is entirely Claude Code's job.)"""
    info = fetch_live()
    if info is None:
        # Fallback caches: CC's own usage-API cache (richer — has scoped caps)
        # and the statusline mirror (two windows). Pick the FRESHEST that
        # actually HAS a reading, so info shows ASAP without (a) a stale rich
        # cache shadowing a fresher thin one, nor (b) a fresh-but-EMPTY cache
        # (e.g. a session-start statusline with no rate_limits) shadowing an
        # older one that still holds real numbers.
        def _has_reading(c):
            return (c["five_hour"].get("used_percentage") is not None
                    or c["seven_day"].get("used_percentage") is not None
                    or bool(c.get("scoped")))
        cands = [c for c in (load_cc_cache(), load_cache()) if c is not None]
        pool = [c for c in cands if _has_reading(c)] or cands
        info = min(pool, key=lambda c: c.get("age", float("inf"))) if pool else None
    if info is not None:
        _save_weekly_anchor(info.get("seven_day", {}).get("resets_at"))
    return info


def _payload():
    """Compute the display payload (the same values the ANSI view derives), or
    None if usage is unavailable. Shared by --json and --html."""
    info = _fetch_info()
    if info is None:
        return None
    now_ms = time.time() * 1000

    def win(node, window_ms, day_stepped=False):
        pct = parse_pct(node.get("used_percentage"))
        rem = remaining_ms(node, now_ms)
        el = elapsed_of(rem, window_ms) if rem is not None else None
        mk = day_marker_pct(rem, window_ms) if (day_stepped and rem is not None) else el
        return {"used": pct, "elapsed": el, "marker": mk,
                "resets": fmt_duration(rem) if rem is not None else None}

    seven_node = info["seven_day"]
    seven = win(seven_node, WEEK_MS, day_stepped=True)
    pace = None
    if seven["used"] is not None and seven["elapsed"] is not None:
        p = weekly_pace(seven["used"], seven["elapsed"],
                        remaining_ms(seven_node, now_ms))
        if p:
            pace = p[0]
    is_expired, expired_ago = check_token_expiry()
    return {
        "plan": info.get("plan"),
        "session": win(info["five_hour"], SESSION_MS),
        "weekly": seven,
        "pace": pace,
        "scoped": [{"model": m, "used": pct, "active": a}
                   for m, pct, a in info["scoped"]],
        "source": info["source"],
        "age_secs": round(info["age"]),
        "token_expired_secs": expired_ago if is_expired else None,
        "fetch_error": _FETCH_ERR if info["source"] != "live" else None,
    }


def emit_json():
    """Machine-readable payload — the ANSI values without terminal formatting."""
    p = _payload()
    if p is None:
        print(json.dumps({"error": "unavailable"}))
        return 1
    if p.get("token_expired_secs") is None:
        p.pop("token_expired_secs", None)
    if p.get("fetch_error") is None:
        p.pop("fetch_error", None)
    print(json.dumps(p))
    return 0


