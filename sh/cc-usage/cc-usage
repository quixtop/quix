def _render_html(p):
    """Build a self-contained HTML gauge page from the payload."""
    def col(used):
        # Same 10-tier green→yellow→red gradient the terminal bar uses.
        if used is None:
            return "#5a5a66"
        return GYR_HEX[gyr_tier(used)]

    def bar(label, used, elapsed, right):
        u = min(100, max(0, used or 0))
        tick = ("" if elapsed is None
                else '<span class=tk style="left:%d%%"></span>' % min(100, max(0, elapsed)))
        return ('<div class=row><span class=lb>%s</span>'
                '<span class=track><span class=fill style="width:%d%%;background:%s"></span>%s</span>'
                '<span class=rt>%s</span></div>') % (label, u, col(used), tick, right)

    rows = []
    s = p["session"]
    rows.append(bar("5-hour session", s.get("used"), s.get("elapsed"),
                    "<b>%s%%</b> &middot; %s" % (s.get("used") or 0, s.get("resets") or "—")))
    w = p["weekly"]
    rows.append(bar("weekly", w.get("used"), w.get("marker"),
                    "<b>%s%%</b> &middot; %s" % (w.get("used") or 0, w.get("resets") or "—")))
    for sc in p.get("scoped", []):
        if not sc.get("used"):
            continue
        tag = " &middot; binding" if sc.get("active") else ""
        rows.append(bar("✦ %s" % sc["model"], sc["used"], w.get("marker"),
                        "<b>%s%%</b>%s" % (sc["used"], tag)))
    if p.get("pace") and SHOW_PACE:
        proj = None
        if p["pace"].startswith("proj "):
            try:
                proj = int(p["pace"].split("%", 1)[0].replace("proj", "").strip())
            except ValueError:
                proj = None
        pc = col(proj) if proj is not None else "#8b949e"
        rows.append('<div class=row><span class=lb>pace</span>'
                    '<span style="font-size:13px;color:%s">%s</span></div>' % (pc, p["pace"]))

    plan = p.get("plan")
    plan_html = ('<span class=plan>%s</span>' % plan) if plan else ""
    if p.get("source") == "live":
        cap = '<span style="color:#3fb950">&#9679; live &middot; just now</span>'
    else:
        cap = "cached &middot; as of %s" % age_str(p.get("age_secs") or 0)
        exp = p.get("token_expired_secs")
        if exp:
            cap += " &middot; token expired %s &mdash; auto-refreshing, reload shortly" % age_str(exp)
        elif p.get("fetch_error"):
            cap += " &middot; live fetch failed: %s" % _esc(p["fetch_error"])
    return _HTML_TMPL % {"plan": plan_html, "rows": "\n".join(rows), "cap": cap}


def emit_html():
    """Generate a self-contained HTML gauge and open it in the browser."""
    p = _payload()
    if p is None:
        sys.stderr.write("cc-usage: usage unavailable (no live call, no cache)\n")
        return 1
    out = os.path.join(os.environ.get("TMPDIR", "/tmp"), "cc-usage.html")
    with open(out, "w") as f:
        f.write(_render_html(p))
    print("cc-usage: wrote %s" % out)
    try:
        subprocess.run(["open", out], timeout=5, stderr=subprocess.DEVNULL)
    except Exception:
        print("cc-usage: open it manually → %s" % out)
    return 0


def _esc(s):
    """Minimal HTML escape for values interpolated into the widget fragment —
    plan/model come from the live API, so treat them as untrusted."""
    return (str(s).replace("&", "&amp;").replace("<", "&lt;")
            .replace(">", "&gt;").replace('"', "&quot;"))


def _render_widget(p):
    """Build the inline show_widget HTML fragment — CC-native (CSS variables,
    no hardcoded background, centred), same 10-tier gradient as the terminal
    bar. Returned inside the --widget envelope for the skill to render."""
    def col(used):
        return "#5a5a66" if used is None else GYR_HEX[gyr_tier(used)]

    def bar(label, used, elapsed, right):
        u = min(100, max(0, used or 0))
        tick = ""
        if elapsed is not None:
            e = min(100, max(0, elapsed))
