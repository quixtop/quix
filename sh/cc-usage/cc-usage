            f'<span style="font-size:12px;color:var(--text-secondary)">'
            f'{_esc(right)}</span></div>'
            f'<div style="position:relative;height:8px;'
            f'background:var(--surface-1);border-radius:4px;overflow:hidden">'
            f'<div style="position:absolute;top:0;left:0;width:{u}%;height:100%;'
