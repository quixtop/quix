    else:
        cap = f"cached · as of {age_str(p.get('age_secs') or 0)}"
        if p.get("token_expired_secs"):
            cap += (f" · token expired {age_str(p['token_expired_secs'])}"
                    f" — auto-refreshing, glance again")
        elif p.get("fetch_error"):
            cap += f" · live fetch failed: {_esc(p['fetch_error'])}"

    legend = (
        f'<div style="font-size:11px;color:var(--text-muted);margin-top:12px;'
        f'padding-top:10px;border-top:0.5px solid var(--border)">'
