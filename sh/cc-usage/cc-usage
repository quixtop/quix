               f"{s.get('used') or 0}% · {s.get('resets') or '—'}")
    core += bar("weekly", w.get("used"), w.get("marker"),
                f"{w.get('used') or 0}% · {w.get('resets') or '—'}")

    plan = ""
    if p.get("plan"):
        plan = (f'<div style="margin-bottom:12px;padding:9px 12px;'
                f'background:var(--surface-1);border-radius:8px;font-size:12px;'
                f'font-weight:500;color:var(--text-primary)">'
