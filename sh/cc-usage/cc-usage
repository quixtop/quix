def _read_plan_cfg():
    """Persisted {active, custom} — the selected plan id plus any user-defined
    plans. Malformed/missing file falls back to plan 0, no custom plans."""
    try:
        with open(PLANS_FILE) as f:
            d = json.load(f)
        if not isinstance(d, dict):
            raise ValueError
        custom = d.get("custom") or {}
        return {"active": d.get("active", 0),
                "custom": custom if isinstance(custom, dict) else {}}
    except (OSError, ValueError):
        return {"active": 0, "custom": {}}


def _write_plan_cfg(cfg):
    try:
        with open(PLANS_FILE, "w") as f:
            json.dump(cfg, f, indent=1)
        return True
    except OSError:
        return False


def load_plans():
    """(plans_by_id, active_id) — built-ins merged with custom definitions."""
    cfg = _read_plan_cfg()
    plans = dict(BUILTIN_PLANS)
    for k, v in cfg["custom"].items():
        try:
            plans[int(k)] = v
        except (TypeError, ValueError):
            continue
    active = cfg["active"]
    if active not in plans:
        active = 0
    return plans, active

