#!/usr/bin/env bash
# (c) Shrix
# author: shrix
# cc-dash — launch the Claude Code dashboard in the default browser
#
# Starts the dashboard server (Next.js, ~/.claude/dashboard) on PORT if it
# isn't already running, waits up to 15s for it to bind, then opens the URL.
# Pure dashboard launcher — does not start or interact with any Claude session.

set -euo pipefail

# Trailing gap — one blank line after this script's output, TTY only, so piped
# or redirected output stays exactly the data. Fires on every exit path.
_gap() { [ -t 1 ] && printf '\n'; return 0; }
trap _gap EXIT

# Colours + the `status` closing line (TTY-guarded). See code-quality rule
# § Script Output Contract.
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/proj-env.sh"

show_help() {
    cat <<'HELP'
cc-dash — launch the Claude Code dashboard in the default browser

USAGE
  cc-dash                  Start dashboard on port 3333, open in browser
  cc-dash --no-open        Start server + print URL, but don't open a browser
  cc-dash -h, --help       Show this help

BEHAVIOR
  - Starts the dashboard server (Next.js, ~/.claude/dashboard) if not already listening
  - Waits up to 15s for the port to bind
  - Opens http://localhost:3333/active (the Active view) in default browser
  - With --no-open: prints the URL instead (the /cc-dash command opens it in
    Claude's own in-app browser)
  - Pure launcher — does not start or interact with any Claude session

FILES
  ~/.claude/dashboard           Dashboard project directory
  $TMPDIR/claude-dashboard.log  Server log (check on startup failure)
HELP
}

NO_OPEN=0
case "${1:-}" in
    -h|--help) show_help; exit 0 ;;
    --no-open) NO_OPEN=1 ;;   # start server + print URL; caller opens the browser
esac

PORT=3333
URL="http://localhost:${PORT}/active"
DASHBOARD_DIR="${HOME}/.claude/dashboard"
# $TMPDIR, not a hardcoded /tmp: /tmp is read-only inside the Claude Code
# sandbox, so a hardcoded path made the log redirect (and thus server start)
# fail with "Operation not permitted". $TMPDIR is writable in every context.
LOG_FILE="${TMPDIR:-/tmp}/claude-dashboard.log"
READY_TIMEOUT_S=15

is_listening() {
    lsof -iTCP:"${PORT}" -sTCP:LISTEN &>/dev/null
}

# --- Pre-flight ---------------------------------------------------------
if [[ ! -d "${DASHBOARD_DIR}" ]]; then
    printf "cc-dash: dashboard directory not found: %s\n" "${DASHBOARD_DIR}" >&2
    exit 1
fi

# --- Start server if not already running --------------------------------
if ! is_listening; then
    (cd "${DASHBOARD_DIR}" && nohup bun run dev -- -p "${PORT}" &>"${LOG_FILE}" &)
    # Poll up to READY_TIMEOUT_S (0.5s × 30 = 15s) for the port to bind
    for _ in $(seq 1 $((READY_TIMEOUT_S * 2))); do
        is_listening && break
        sleep 0.5
    done
fi

# --- Open (or, with --no-open, just report the URL) ---------------------
if is_listening; then
    if [[ "${NO_OPEN}" != "1" ]]; then open "${URL}"; fi
    status ok "dashboard ready — ${URL}"
else
    status fail "dashboard did not start within ${READY_TIMEOUT_S}s — see ${LOG_FILE}"
    exit 1
fi
