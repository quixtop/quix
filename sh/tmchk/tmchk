#!/usr/bin/env bash
# (c) Shrix
# author: shrix
# tmchk — Time Machine at a glance: each backup disk's snapshots and how fresh the latest is,
# plus the launchd job that backs it up: its schedule and its last logged run.
#
# Disks come from Time Machine itself (tmutil destinationinfo), so a mount point like
# "mini-tm-ssd 1" still works. A disk that is not plugged in gets no snapshot check and
# is named; its job is still checked.
# A latest snapshot older than its schedule allows is flagged ⚠; a disk with no age
# limit set (see max_age_hours) is listed but not age-checked, and says so.
# Under each disk, "job <name>:" shows the schedule launchd holds (what will actually run)
# and the last run logged in ~/Library/Logs/tm-jobs.log. Flagged ⚠: a job that is not
# loaded, a last run that failed, a run still going after max_run_hours or one that
# started and never finished, and a last exit launchd reports as failed (e.g. the job's
# script could not start, so nothing was logged).
#
# Usage:
#   tmchk                show every Time Machine disk and its job
#   tmchk -h | --help | help
#
# Read-only: it lists snapshots and reads launchd and the job log; it never starts, stops
# or deletes a backup.
# Exit: 0 every connected disk fresh and every job healthy (✓) · 1 something needs a look (⚠)
#       or tmchk failed (✗)

# How old the latest snapshot may get before ⚠, per disk name, in hours.
# PROVISIONAL: the schedule plus a margin — both run daily, mini-tm-nvme at 00:00 and
# mini-tm-ssd at 12:00 (agreed 11 Oct 2026). 24 h + 2 h: 10 logged runs on 10–11 Oct took
# 26 s–124 s (median 38 s), so the margin is for a Mac that wakes late, not for the backup
# itself. A disk not listed here gets no age check.
max_age_hours() {
  case "$1" in
    mini-tm-nvme) echo 26 ;;
    mini-tm-ssd)  echo 26 ;;
    *)            echo "" ;;
  esac
}

# Which launchd job backs up each disk: com.shrix.<job>, running ~/Library/Scripts/shrix/<job>.
# A disk not listed here gets no job line.
job_for() {
  case "$1" in
    mini-tm-nvme) echo tm-nvme ;;
    mini-tm-ssd)  echo tm-ssd ;;
    *)            echo "" ;;
  esac
}

TM_JOBS_LOG="${TM_JOBS_LOG:-$HOME/Library/Logs/tm-jobs.log}"   # override only for tests

# How long a run may stay "running" before ⚠. PROVISIONAL: 10 logged runs on 10–11 Oct
# took 26 s–124 s (median 38 s); 2 h leaves room for a large catch-up backup.
max_run_hours=2

usage() {
  awk 'NR==1 { next } /^# \(c\)/ { next } /^# author:/ { next } /^#/ { sub(/^# ?/,""); print; next } { exit }' "$0"
}

# destinationinfo text → one line per disk: name<TAB>mount point (empty when not mounted).
# Splits each line at its FIRST colon only, so names and paths may contain colons.
parse_destinations() {
  awk '
    /^>? *=+$/ { if (name != "") print name "\t" mp; name = ""; mp = ""; next }
    { key = $0; sub(/ *:.*/, "", key); val = $0; sub(/^[^:]*: */, "", val) }
    key == "Name"        { name = val }
    key == "Mount Point" { mp = val }
    END { if (name != "") print name "\t" mp }'
}

TM_NAME='^com\.apple\.TimeMachine\.[0-9]\{4\}-[0-9][0-9]-[0-9][0-9]-[0-9]\{6\}\.backup$'

# com.apple.TimeMachine.2026-10-09-211526.backup → epoch seconds (local time)
snap_epoch() {
  local stamp
  stamp=$(printf '%s\n' "$1" | sed -n 's/.*\.\([0-9]\{4\}-[0-9][0-9]-[0-9][0-9]-[0-9]\{6\}\)\..*/\1/p')
  [ -n "$stamp" ] && date -j -f '%Y-%m-%d-%H%M%S' "$stamp" +%s 2>/dev/null
}

human_age() {   # seconds → "3 h 05 min" / "2 d 4 h"
  local s=$1
  if [ "$s" -ge 172800 ]; then printf '%d d %d h' $((s / 86400)) $((s % 86400 / 3600))
  else printf '%d h %02d min' $((s / 3600)) $((s % 3600 / 60)); fi
}

status_fallback() {
  status() {
    local g='' y='' r='' n=''
    [ -t 1 ] && { g='\033[0;32m'; y='\033[1;33m'; r='\033[0;31m'; n='\033[0m'; }
    case "$1" in
      ok)   printf "${g}✓ %s${n}\n" "$2" ;;
      warn) printf "${y}⚠ %s${n}\n" "$2" ;;
      *)    printf "${r}✗ %s${n}\n" "$2" >&2 ;;
    esac
  }
}

# launchctl print text → its calendar schedule in words: "daily at 12:00", "hourly at :00",
# "day 3 at 10:00" — several schedules joined with ", ". Only calendar triggers count.
schedule_of() {
  awk '
    /stream = /       { cal = ($NF == "com.apple.launchd.calendarinterval") }
    /descriptor = \{/ { inb = cal; h = ""; m = ""; d = ""; w = ""; mo = ""; next }
    inb && /"Hour"/    { h = $NF }
    inb && /"Minute"/  { m = $NF }
    inb && /"Day"/     { d = $NF }
    inb && /"Weekday"/ { w = $NF }
    inb && /"Month"/   { mo = $NF }
    inb && /^[ \t]*\}/ {
      inb = 0
      if (h != "" && m != "") { t = sprintf("%02d:%02d", h, m); at = " at " t }
      else {
        if (h != "")      t = sprintf("every minute of hour %02d", h)
        else if (m != "") t = sprintf("hourly at :%02d", m)
        else              t = "every minute"
        at = ", " t
      }
      if (d != "")                 s = "day " d at
      else if (w != "")            s = "weekday " w at
      else if (h != "" && m != "") s = "daily" at
      else                         s = t
      if (mo != "") s = "month " mo ", " s
      out = out (out == "" ? "" : ", ") s
    }
    END { print (out == "" ? "no calendar schedule" : out) }'
}

# The job line under a disk. Returns 1 when it needs a look.
job_line() {
  local job; job=$(job_for "$1")
  [ -n "$job" ] || return 0
  local info
  if ! info=$(launchctl print "gui/$(id -u)/com.shrix.$job" 2>&1); then
    if printf '%s' "$info" | grep -q 'Could not find service'; then
      echo "    job $job: not loaded — no backups will run  ⚠"
    else
      echo "    job $job: launchctl could not read it ($(printf '%s\n' "$info" | head -1))  ⚠"
    fi
    return 1
  fi
  local sched state lexit last ts code started
  sched=$(printf '%s\n' "$info" | schedule_of)
  state=$(printf '%s\n' "$info" | awk '/^\tstate = / { print $3; exit }')
  # launchd's own record: "0", "78: Function not implemented", or "(never exited)" since loaded
  lexit=$(printf '%s\n' "$info" | awk '/^\tlast exit code = / { v = $5; sub(/:$/, "", v); print v; exit }')
  # "<date> <time> tm-ssd started" · "✓ <date> <time> tm-ssd exit=0" (older runs: no ✓/✗)
  last=$(grep -aE "[0-9:]+ $job (started|exit=[0-9]+)\$" "$TM_JOBS_LOG" 2>/dev/null | tail -1)
  ts=$(printf '%s\n' "$last" | sed -nE 's/^(✓ |✗ )?([0-9-]+ [0-9:]+) .*/\2/p')
  code=$(printf '%s\n' "$last" | sed -nE 's/.* exit=([0-9]+)$/\1/p')
  local line="    job $job: $sched · "
  if [ -n "$code" ] && [ "$code" != 0 ]; then
    echo "${line}last run ✗ $ts exit=$code  ⚠"; return 1
  elif [ -n "$last" ] && [ -z "$code" ]; then
    started=$(date -j -f '%Y-%m-%d %H:%M:%S' "$ts" +%s 2>/dev/null)
    if [ "$state" != running ]; then
      echo "${line}last run started $ts but never finished  ⚠"; return 1
    elif [ -n "$started" ] && [ $(( $(date +%s) - started )) -gt $((max_run_hours * 3600)) ]; then
      echo "${line}running since $ts — over $max_run_hours h, may be stuck  ⚠"; return 1
    fi
    echo "${line}running since $ts"; return 0
  fi
  if [ -z "$last" ]; then line="${line}no run logged yet"
  else line="${line}last run ✓ $ts exit=0"; fi
  # the log says fine (or nothing), but launchd saw the job fail: the script may not
  # have started at all, so it could not log
  case "$lexit" in
    ''|0|'(never') echo "$line" ;;
    *) echo "$line  ⚠ launchd: last exit code $lexit"; return 1 ;;
  esac
}

# One disk's snapshot line. Returns 1 when it needs a look; also updates main's checked,
# skipped and nolimit (bash functions see their caller's locals).
disk_line() {
  local name=$1 mp=$2
  if [ -z "$mp" ] || [ ! -d "$mp" ]; then
    echo "$name — not connected, skipped"
    skipped="${skipped:+$skipped, }$name"
    return 0
  fi
  checked=$((checked + 1))
  local raw snaps count latest when age limit line
  if ! raw=$(diskutil apfs listSnapshots "$mp" 2>&1); then
    echo "$name — could not list snapshots ($mp): $(printf '%s\n' "$raw" | head -1)"
    return 1
  fi
  # entries look like "|   Name: …" (the last one "    Name: …"), so allow tree marks
  snaps=$(printf '%s\n' "$raw" | sed -n 's/^[| ]*Name: *//p')
  count=$(printf '%s' "$snaps" | grep -c . || true)
  if [ "$count" -eq 0 ]; then
    echo "$name — no snapshots yet ($mp)"
    return 1
  fi
  # the newest Time Machine snapshot only; their names sort chronologically
  latest=$(printf '%s\n' "$snaps" | grep "$TM_NAME" | LC_ALL=C sort | tail -1)
  when=""
  [ -n "$latest" ] && when=$(snap_epoch "$latest")
  if [ -z "$when" ]; then
    echo "$name — $count snapshot(s), none with a Time Machine date  ⚠"
    return 1
  fi
  age=$((now - when))
  line="$name — $count snapshot(s), latest $(date -r "$when" '+%Y-%m-%d %H:%M')"
  if [ "$age" -lt 0 ]; then
    echo "$line  ⚠ dated in the future — check the clock"
    return 1
  fi
  line="$line ($(human_age "$age") ago)"
  limit=$(max_age_hours "$name")
  if [ -z "$limit" ]; then
    echo "$line  (no age limit set)"
    nolimit="${nolimit:+$nolimit, }$name"
  elif [ "$age" -gt $((limit * 3600)) ]; then
    echo "$line  ⚠ older than ${limit} h"
    return 1
  else
    echo "$line"
  fi
  return 0
}

main() {
  case "${1:-}" in
    -h|--help|help) usage; return 0 ;;
    "") ;;
    *) status fail "unknown option $1 — tmchk -h"; return 1 ;;
  esac

  local info
  info=$(tmutil destinationinfo 2>&1) || { status fail "tmutil could not list the backup disks: $info"; return 1; }
  local disks
  disks=$(printf '%s\n' "$info" | parse_destinations)
  if [ -z "$disks" ]; then
    status warn "Time Machine lists no backup disks ($(printf '%s' "$info" | head -1))"; return 1
  fi

  local running
  running=$(tmutil status 2>/dev/null | awk -F' = ' '/Running/ {gsub(/;/,"",$2); print $2}')
  [ "$running" = 1 ] && echo "Time Machine is backing up right now."

  local now problems=0 checked=0 skipped="" nolimit=""
  now=$(date +%s)
  local bad
  while IFS=$'\t' read -r name mp; do
    [ -n "$name" ] || continue
    bad=0
    disk_line "$name" "$mp" || bad=1
    job_line "$name" || bad=1
    problems=$((problems + bad))
  done <<< "$disks"

  local note=""
  [ -n "$nolimit" ] && note="$note · not age-checked: $nolimit"
  [ -n "$skipped" ] && note="$note · not connected: $skipped"
  if [ "$checked" -eq 0 ]; then
    status warn "no Time Machine disk is connected$note"; return 1
  elif [ "$problems" -gt 0 ]; then
    status warn "$problems disk(s) need a look$note"; return 1
  else
    status ok "every connected Time Machine disk is up to date$note"; return 0
  fi
}

# Run only when executed: sourcing the file (for tests) defines the functions and
# changes nothing else in the calling shell.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  set -uo pipefail
  _gap() { [ -t 1 ] && printf '\n'; return 0; }
  trap _gap EXIT
  # shellcheck source=/dev/null
  [ -r "$HOME/.local/bin/proj-env.sh" ] && source "$HOME/.local/bin/proj-env.sh"
  declare -F status >/dev/null || status_fallback
  main "$@"
  exit $?
fi
